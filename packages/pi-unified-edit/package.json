{
  "name": "pi-unified-edit",
  "version": "0.3.0",
  "description": "Atomic multi-file pi edit extension with patch, rows, code, pi-JSON, and OMP-compatible hash-line modes.",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "edit",
    "patch",
    "hashline"
  ],
  "files": [
    "unified-edit.ts",
    "hash-edit.ts",
    "tests",
    "scripts/*.py",
    "README.md",
    "Changelog.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "npm run check && tsx --test tests/*.test.ts"
  },
  "pi": {
    "extensions": [
      "unified-edit.ts"
    ]
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.8.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^24.0.0",
    "tsx": "latest",
    "typescript": "latest"
  }
}
