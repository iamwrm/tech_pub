    "hash-edit.ts",
    "README.md",
    "Changelog.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "npm run check && tsx --test edit.test.ts"
