  "pi": {
    "extensions": [
      "unified-edit.ts"
    ]
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.8.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
