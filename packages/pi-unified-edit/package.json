{
  "name": "pi-unified-edit",
  "version": "0.4.2",
  "description": "Atomic multi-file Pi edit extension with OMP-compatible hash-line edits.",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "edit",
    "hashline"
  ],
  "files": [
