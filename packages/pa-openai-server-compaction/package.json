{
  "name": "pa-openai-server-compaction",
  "version": "0.1.2",
  "description": "Prime Agent extension: OpenAI Responses server-side compaction (native opaque checkpoint) for GPT-series models, replacing the readable/portable summary with the provider's own compaction artifact.",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "prime-agent",
    "extension",
    "compaction",
    "openai",
    "codex",
    "responses"
  ],
  "files": [
    "index.ts",
    "openai-server-compaction.ts",
    "tests",
    "README.md",
    "Changelog.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "npm run check && node --experimental-strip-types --test tests/*.test.ts",
    "test:py": "uv run --project tests/py python -m unittest discover -s tests/py -v"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.7.1/prime-agent-0.7.1.tgz",
    "@earendil-works/pi-agent-core": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.7.1/prime-agent-core-0.7.1.tgz",
    "@earendil-works/pi-ai": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.7.1/prime-agent-ai-0.7.1.tgz",
    "@earendil-works/pi-tui": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.7.1/prime-agent-tui-0.7.1.tgz",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
