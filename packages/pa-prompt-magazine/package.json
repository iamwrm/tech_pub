{
  "name": "pa-prompt-magazine",
  "version": "0.2.0",
  "description": "Prime Agent extension: multi-slot prompt stash queue ('magazine'). End a draft with ;; to stash it instead of sending; live queue widget above the prompt bar + /magazine browser (restore / peek / delete / reorder / clear).",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "prime-agent",
    "extension",
    "stash",
    "queue",
    "magazine",
    "tui"
  ],
  "files": [
    "index.ts",
    "magazine.ts",
    "tests",
    "README.md",
    "Changelog.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "npm run check && node --experimental-strip-types --test tests/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.7.0/prime-agent-0.7.0.tgz",
    "@earendil-works/pi-tui": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.7.0/prime-agent-tui-0.7.0.tgz",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
