{
  "name": "pa-btw2",
  "version": "0.1.0",
  "description": "Prime Agent extension: /btw2 creates a same-model, same-thinking no-tool side branch and materializes it as a detached resumable session on demand.",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "prime-agent",
    "extension",
    "side-chat",
    "fork",
    "session"
  ],
  "files": [
    "index.ts",
    "btw2.ts",
    "detached-session.ts",
    "terminal-safety.ts",
    "tests",
    "README.md",
    "Changelog.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "npm run check && node --experimental-strip-types --test tests/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.8.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.7.1/prime-agent-0.7.1.tgz",
    "@earendil-works/pi-agent-core": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.7.1/prime-agent-core-0.7.1.tgz",
    "@earendil-works/pi-ai": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.7.1/prime-agent-ai-0.7.1.tgz",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
